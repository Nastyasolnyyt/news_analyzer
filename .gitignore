```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
dist/
build/
target/

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log

# Temporary files
*.tmp
*.swp
*~

# Coverage reports
coverage/
htmlcov/
.coverage

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# MyPy cache
.mypy_cache/
.dmypy.json
dmypy.json

# Pytest cache
.pytest_cache/

# Git
.git/
```